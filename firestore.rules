rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validPlayer(p) {
      return p is map
        && p.name is string
        && (p.id == null || p.id is string)
        && (p.rating == null || p.rating is number)
        && (p.ratingDiff == null || p.ratingDiff is number);
    }

    function validGame(g, id) {
      return g.id == id
        && g.id is string
        && g.variant == 'standard'
        && g.rated is bool
        && g.speed is string
        && g.perf is string
        && g.createdAt is number
        && g.lastMoveAt is number
        && g.status is string
        && (g.winner == null || g.winner in ['white', 'black'])
        && g.players is list
        && g.players.size() >= 1
        && g.players.size() <= 2
        && g.players[0] is string
        && (g.players.size() < 2 || g.players[1] is string)
        && validPlayer(g.white)
        && validPlayer(g.black)
        && g.moves is string
        && g.moves.size() > 0
        && g.moves.size() < 20000
        && (g.opening == null
          || (g.opening is map && g.opening.eco is string && g.opening.name is string && g.opening.ply is number))
        && (g.clock == null
          || (g.clock is map && g.clock.initial is number && g.clock.increment is number))
        && (g.source == null || g.source is string);
    }

    function validEval(e, id) {
      return e.key == id
        && e.fen is string
        && e.fen.size() < 120
        && (e.cp == null || e.cp is number)
        && (e.mate == null || e.mate is number)
        && (e.cp != null || e.mate != null)
        && e.depth is number
        && e.depth >= 1
        && e.depth <= 99
        && (e.bestMove == null || e.bestMove is string)
        && e.pv is string
        && e.pv.size() < 400
        && e.engine is string
        && e.nodes is number
        && e.evaluatedAt is number
        && e.uploadedBy == request.auth.uid
        && e.uploadedAt == request.time;
    }

    // Per-user private data: profile, Lichess link and token, later annotations.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Public chess games, shared by everyone. Lichess games are immutable, so a
    // document is written once by whichever player syncs it first and never
    // changed. The writer is recorded, and the server timestamp drives the
    // incremental pull on other devices.
    //
    // The Lichess account behind a Google account is linked client-side, so the
    // rules cannot prove a writer really played the game; the shape checks
    // keep documents well-formed, and a server-verified link is in the backlog.
    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validGame(request.resource.data, gameId)
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.uploadedAt == request.time;
      allow update, delete: if false;
    }

    // Engine evaluations keyed by position. Anyone signed in may add one, and
    // an existing record is replaced only by a deeper search.
    match /positions/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && validEval(request.resource.data, key);
      allow update: if signedIn()
        && validEval(request.resource.data, key)
        && request.resource.data.depth > resource.data.depth;
      allow delete: if false;
    }
  }
}
